# Não exponha a API fora do localhost sem uma chave longa e aleatória.
KEILINKS_HOST=127.0.0.1
KEILINKS_PORT=8000
KEILINKS_API_KEY=
KEILINKS_CORS_ORIGINS=http://127.0.0.1:5000,http://localhost:5000
# Necessária apenas se você expuser o servidor legado fora do localhost.
KEILINKS_LEGACY_API_KEY=

# Banco legado: use segredos reais fora do controle de versão.
KEILINKS_DB_HOST=127.0.0.1
KEILINKS_DB_PORT=3309
KEILINKS_DB_USER=root
KEILINKS_DB_PASSWORD=
KEILINKS_DB_NAME=keilinks
KEILINKS_ALLOW_EMPTY_DB_PASSWORD=0
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
KEILINKS_AUTH_SECRET=
KEILINKS_AUTH_TOKEN_TTL_SECONDS=604800

# Base recomendada para a RTX 5050 8 GB. O adaptador é criado pelo treino Unsloth.
KEILINKS_BASE_MODEL=unsloth/Qwen3-4B-Instruct-2507-unsloth-bnb-4bit
KEILINKS_ADAPTER_PATH=checkpoints/keilinks-qwen3-4b-lora-v4-controlled
KEILINKS_MAX_SEQ_LENGTH=2048
KEILINKS_MAX_NEW_TOKENS=384

# Dados locais nunca devem ser enviados ao treino sem consentimento explícito.
KEILINKS_DATA_DIR=keilinks_data
KEILINKS_RAG_DB=keilinks_data/rag.sqlite3
KEILINKS_FEEDBACK_PATH=keilinks_data/feedback/consented_feedback.jsonl
KEILINKS_RAG_DENSE_ENABLED=true
KEILINKS_RAG_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Visão usa co-processamento sequencial; não mantém VLM e LLM na VRAM ao mesmo tempo.
KEILINKS_ENABLE_VISION=false
KEILINKS_VISION_MODEL=HuggingFaceTB/SmolVLM2-2.2B-Instruct
KEILINKS_VISION_MAX_NEW_TOKENS=192
